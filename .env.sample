# .env.sample — copy to .env and fill in values
# All variables listed here are required unless marked [optional]


# [KEY_NAME]=[description]
# Example:
# API_KEY=your_api_key_here
# DATABASE_URL=postgresql://user:password@localhost/dbname

# If this project has no environment variables, leave this file with only this comment.

# --- Project-specific variables (preserved by upgrade; not overwritten by template sync) ---
# SAP System Connection
SAP_URL=http://<YOUR_SAP_HOST>:<PORT>
SAP_USER=<YOUR_USERNAME>
SAP_PASSWORD=<YOUR_PASSWORD>
SAP_CLIENT=<CLIENT_NUMBER>
SAP_LANGUAGE=EN

# SAP Mode: hyperfocused | focused | expert
# hyperfocused = 1 tool (SAP) — recommended for AI agents
# focused = 98 tools, expert = 148 tools (vsp v2.60.0 --help)
SAP_MODE=hyperfocused

# Allowed packages (comma-separated, wildcards supported)
# Include $ZADT_VSP and $VSP_ADT to allow WebSocket debug infrastructure
SAP_ALLOWED_PACKAGES=Z*,$TMP,$ZADT_VSP,$VSP_ADT

# Feature flags
# Privileged features (abapGit, transport, ...) default to off. Enable locally only when approved.
SAP_FEATURE_ABAPGIT=off

# Safety options (vsp v2.60.0) — all commented; defaults are the safe choice
# Pin the connection to one system: SID[.CLIENT][/USER]. vsp refuses to log on / work if the system differs.
# SAP_EXPECT=<SID>.<client>
# Block RunQuery free SQL (recommended for sandboxed sessions). NOTE: this also refuses the
# single-SELECT query SAP(action="query", params={"sql_query":...}) that agents use, so leave it off
# unless table reads via TABL_CONTENTS / structured actions are enough.
# SAP_BLOCK_FREE_SQL=true
# Read-only analyst sessions: blocks all create/update/delete/activate operations.
# SAP_READ_ONLY=true
# Opt-in for /transport only (default off): transport management and edits in transportable packages.
# SAP_ENABLE_TRANSPORTS=true
# SAP_ALLOW_TRANSPORTABLE_EDITS=true

# ------------------------------------------------------------
# Example: SAP NetWeaver Trial (NPL)
# SAP_URL=http://vhcalnplci:50000
# SAP_USER=DEVELOPER
# SAP_PASSWORD=<YOUR_PASSWORD>
# SAP_CLIENT=001
#
# Example: Corporate system
# SAP_URL=https://your-sap-dev.company.com:44300
# SAP_USER=JSMITH
# SAP_PASSWORD=<YOUR_SECURE_PASSWORD>
# SAP_CLIENT=100
# SAP_MODE=focused
# SAP_ALLOWED_PACKAGES=Z*,Y*,$TMP
# ------------------------------------------------------------
