{
  "//": "Safe MCP configuration for vsp, routed through scripts/sap-mcp-proxy.ts (policy gate, approvals, audit; applies safe SAP_* defaults and reads .env itself, so no env block is needed). Privileged SAP features default to off. To opt in locally, copy this file to ignored .mcp.local.json, change only approved SAP_FEATURE_* values to on, and configure your MCP client to use that local file.",
  "//safety": "Optional vsp env hardening, add an \"env\" block to an abap server only when needed (the proxy passes it through to vsp): SAP_EXPECT=<SID>.<client> (pin the target system, recommended); SAP_READ_ONLY=true (read-only analyst sessions); SAP_BLOCK_FREE_SQL=true (also blocks the single-SELECT RunQuery agents use, so off by default); SAP_ENABLE_TRANSPORTS=true and SAP_ALLOW_TRANSPORTABLE_EDITS=true (opt-in for /transport only, default off).",
  "mcpServers": {
    "abap-windows": {
      "command": "bun",
      "args": [
        "scripts/sap-mcp-proxy.ts",
        "--",
        "--mode",
        "hyperfocused"
      ]
    },
    "abap-macos": {
      "command": "bun",
      "args": [
        "scripts/sap-mcp-proxy.ts",
        "--",
        "--mode",
        "hyperfocused"
      ]
    },
    "abap-linux": {
      "command": "bun",
      "args": [
        "scripts/sap-mcp-proxy.ts",
        "--",
        "--mode",
        "hyperfocused"
      ]
    },
    "abap-docs": {
      "type": "http",
      "url": "https://mcp-abap.marianzeis.de/mcp"
    },
    "sap-docs": {
      "type": "http",
      "url": "https://mcp-sap-docs.marianzeis.de/mcp"
    }
  }
}
